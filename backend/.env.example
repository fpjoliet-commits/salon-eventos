GOOGLE_SERVICE_ACCOUNT_KEY=./credentials.json
SPREADSHEET_ID=
JWT_SECRET=cambiar_este_secreto_en_produccion
PORT=3001

# Passwords — NO van en texto plano. Cada variable lleva el HASH bcrypt de la
# contraseña. Para generar uno: node backend/hash-password.js "tuContraseña"
# (el resultado empieza con $2b$... — eso es lo que va acá abajo)
PASSWORD_SUPERADMIN=
PASSWORD_ADMIN=
PASSWORD_EMPLEADO=

# ── PDF de la propuesta (PDFShift) ──
# Sin esta key el creador sigue funcionando: cae al diálogo de impresión del
# navegador. Con la key, el PDF se descarga solo y se puede abrir en el visor.
# La key sale de https://pdfshift.io (el plan gratis da 50 PDF por mes).
PDFSHIFT_API_KEY=
# URL pública del CRM: el servicio de PDF necesita poder bajar las imágenes.
PUBLIC_BASE_URL=https://salon-eventos.onrender.com
# Modo prueba: arma el PDF con marca de agua y NO gasta créditos del plan.
# En local ya se activa solo; poner 1 acá sirve para probar contra el deploy.
# PDF_SANDBOX=1

# ── Bot de WhatsApp (WhatsApp Cloud API de Meta) ──
# Mientras estén vacías, el bot queda dormido y no afecta al resto de la app.
# Cómo obtener cada valor: ver docs/whatsapp-bot-setup.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# GRAPH_API_VERSION=v21.0   # opcional
