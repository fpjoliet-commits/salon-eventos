GOOGLE_SERVICE_ACCOUNT_KEY=./credentials.json
SPREADSHEET_ID=
JWT_SECRET=cambiar_este_secreto_en_produccion
PORT=3001

# Passwords — NO van en texto plano. Cada variable lleva el HASH bcrypt de la
# contraseña. Para generar uno: node backend/hash-password.js "tuContraseña"
# (el resultado empieza con $2b$... — eso es lo que va acá abajo)
PASSWORD_SUPERADMIN=
PASSWORD_ADMIN=
PASSWORD_EMPLEADO=
# Opcionales: cuenta propia de Fabio y de Lautaro (rol superadmin). Si están,
# aparecen en el login y lo que cargan queda con su nombre, no como "superadmin".
PASSWORD_FABIO=
PASSWORD_LAUTARO=

# ── Bot de WhatsApp (WhatsApp Cloud API de Meta) ──
# Mientras estén vacías, el bot queda dormido y no afecta al resto de la app.
# Cómo obtener cada valor: ver docs/whatsapp-bot-setup.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# GRAPH_API_VERSION=v21.0   # opcional

# ── Avisos técnicos por Telegram (solo a Lautaro) ──
# Usa el bot de TELEGRAM_BOT_TOKEN. Chat id de Lautaro: que le escriba al bot y
# mirar https://api.telegram.org/bot<TOKEN>/getUpdates ("chat":{"id": ...}).
# Vacío = los avisos solo quedan en la consola de Render.
TELEGRAM_CHAT_ALERTAS=
# Clave para /api/resumen-semanal (la llama un disparador semanal externo)
RESUMEN_SECRET=
